@page "/app-credentials"
@inherits ReportPageBase<AppCredential>
@inject AppCredentialsReport Report

<PageTitle>App secrets & certificaten · Azure PowerTool</PageTitle>

<header class="page-header">
    <div>
        <h1>App secrets & certificaten</h1>
        <p class="lead">Secrets en certificaten van app registrations die verlopen zijn, binnen @AppCredentialsReport.ExpiringSoonDays dagen verlopen of te lang geldig zijn.</p>
    </div>
</header>

<SignInRequired>
    <ReportToolbar Running="Running" Status="@Status" HasResult="Result is not null" OnRun="RunAsync" OnCancel="Cancel" OnExport="ExportAsync" />
    <label class="check-option">
        <input type="checkbox" @bind="ScanKeyVaults" disabled="@Running" />
        Ook Key Vaults doorzoeken om te vinden waar elk secret of certificaat opgeslagen is (alleen metadata, geen waarden)
    </label>

    @if (Result is not null && !Running)
    {
        <div class="filters">
            <FilterMulti Label="Subscriptions" Options="SubscriptionOptions" Selected="SelectedSubscriptions" OnChanged="StateHasChanged" />
            <FilterMulti Label="Regio's" Options="RegionOptions" Selected="SelectedRegions" OnChanged="StateHasChanged" />
            <SeverityFilter @bind-Value="MinSeverity" />
            <label class="filter-select">
                <span class="label">Key Vault</span>
                <select class="input @(LocationFilter != "" ? "active" : "")" @bind="LocationFilter">
                    <option value="">Alle</option>
                    <option value="found">Locatie gevonden</option>
                    <option value="missing">Niet gevonden</option>
                </select>
            </label>
            <FilterChecks Label="Status" Options="TypeOptions" Excluded="ExcludedTypes" OnChanged="StateHasChanged" />
            <label class="filter-select grow">
                <span class="label">Zoeken</span>
                <input class="input" placeholder="App, app id, eigenaar, Key Vault, secretnaam…" @bind="Filter" @bind:event="oninput" />
            </label>
            @if (HasActiveFilters)
            {
                <button class="btn link" @onclick="ClearFilters">Filters wissen</button>
            }
        </div>
    }

    <ErrorBox Error="Error" />

    @if (Result is not null)
    {
        <WarningList Items="Result.Warnings" />
        <p class="summary">
            <strong>@Filtered.Count</strong> credential(s) die actie vragen
            @if (Filtered.Count != Result.Items.Count) { <span class="muted"> van @Result.Items.Count</span> }
            <span class="muted"> · gegenereerd @Result.GeneratedAt.ToLocalTime().ToString("HH:mm:ss")</span>
        </p>

        @if (Filtered.Count > 0)
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th class="sortable" @onclick='() => SortBy("severity")'>Ernst@(SortIndicator("severity"))</th>
                            <th class="sortable" @onclick='() => SortBy("app")'>App@(SortIndicator("app"))</th>
                            <th class="sortable" @onclick='() => SortBy("kind")'>Soort@(SortIndicator("kind"))</th>
                            <th class="sortable" @onclick='() => SortBy("state")'>Status@(SortIndicator("state"))</th>
                            <th class="sortable" @onclick='() => SortBy("end")'>Vervalt@(SortIndicator("end"))</th>
                            <th class="sortable" @onclick='() => SortBy("location")'>Opgeslagen in@(SortIndicator("location"))</th>
                            <th class="sortable" @onclick='() => SortBy("owners")'>Eigenaars@(SortIndicator("owners"))</th>
                            <th>Wat te doen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Filtered)
                        {
                            <tr>
                                <td><SeverityBadge Value="c.Severity" /></td>
                                <td>
                                    <a href="@AppPortalUrl(c)" target="_blank" rel="noopener"><strong>@c.AppName</strong></a>
                                    <div class="muted small mono">@c.AppId</div>
                                </td>
                                <td>
                                    @(c.Kind == CredentialKind.Secret ? "Secret" : "Certificaat")
                                    @if (c.Description is { Length: > 0 }) { <div class="muted small">@c.Description</div> }
                                </td>
                                <td>@c.StateLabel</td>
                                <td class="small">
                                    @(c.End?.ToLocalTime().ToString("yyyy-MM-dd") ?? "–")
                                    @if (c.DaysLeft is { } days)
                                    {
                                        <div class="muted small">@(days < 0 ? $"{-days} dagen geleden" : $"over {days} dagen")</div>
                                    }
                                </td>
                                <td class="small">
                                    @if (c.Locations.Count == 0)
                                    {
                                        <span class="muted">@(_scanned ? "niet gevonden" : "–")</span>
                                    }
                                    @foreach (var l in c.Locations)
                                    {
                                        <div class="location">
                                            <a href="@VaultItemUrl(l)" target="_blank" rel="noopener"><strong>@l.Vault.Name</strong> / @l.ItemName</a>
                                            <span class="badge @(l.Confidence == MatchConfidence.Certain ? "ok" : l.Confidence == MatchConfidence.Likely ? "" : "warn")" title="@l.Reason">@l.ConfidenceLabel</span>
                                            <div class="muted small">@l.Vault.SubscriptionName · @l.Vault.ResourceGroup · @l.Vault.Location</div>
                                        </div>
                                    }
                                </td>
                                <td class="small">
                                    @if (c.Owners.Count == 0) { <span class="badge warn">Geen eigenaar</span> }
                                    else { @string.Join(", ", c.Owners) }
                                </td>
                                <td class="small">
                                    @c.Fix
                                    <CopyCommand Command="@c.AzCli" />
                                    @if (c.AzCliCleanup is not null)
                                    {
                                        <div class="muted small">@(c.State == CredentialState.Expired ? "Ook in Key Vault opruimen:" : "Daarna, als de applicatie de nieuwe gebruikt:")</div>
                                        <CopyCommand Command="@c.AzCliCleanup" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (!Running)
    {
        <div class="card muted">
            Klik op <strong>Rapport uitvoeren</strong>. Alle app registrations in deze tenant worden via Microsoft Graph opgehaald.
            <ul>
                <li><strong>Verloopt binnenkort</strong>: roteren voor de applicatie uitvalt (hoog binnen @AppCredentialsReport.UrgentDays dagen).</li>
                <li><strong>Te lang geldig</strong>: secrets van meer dan een jaar of zonder einddatum. Liever vervangen door managed identity of federated credentials.</li>
                <li><strong>Verlopen</strong>: opruimen. Heeft de app geen enkele geldige credential meer, check dan of ze nog gebruikt wordt.</li>
            </ul>
            <p>
                Entra ID houdt niet bij <em>waar</em> een secret bewaard wordt. Met de Key Vault-optie zoekt de tool dat zelf, op basis van metadata:
                certificaten op thumbprint (<strong>zeker</strong>); secrets op app id of key id in de naam of tags (<strong>zeker</strong>),
                op dezelfde vervaldatum (<strong>waarschijnlijk</strong>) of een naam die op de app lijkt (<strong>mogelijk</strong>).
                Daarvoor heb je leesrechten op de vaults nodig (Key Vault Reader of een access policy met <em>List</em>) en moet de vault bereikbaar zijn vanaf je machine.
            </p>
            Is de vault bekend, dan zet het rotatiecommando het nieuwe secret meteen in die Key Vault, zonder dat de waarde op je scherm komt.
            Het oude secret verwijder je met het tweede commando, pas als de applicatie het nieuwe gebruikt.
        </div>
    }
</SignInRequired>

@code {
    private bool ScanKeyVaults { get; set; } = true;
    private bool _scanned;
    private string LocationFilter { get; set; } = "";

    protected override async Task<ReportResult<AppCredential>> ExecuteAsync(IProgress<string> progress, CancellationToken ct)
    {
        var scan = ScanKeyVaults;
        var result = await Report.RunAsync(scan, progress, ct);
        _scanned = scan;
        return result;
    }

    /// <summary>Filters use the best Key Vault match; credentials without one fall under "(geen Key Vault gevonden)".</summary>
    private static ResourceRef? Vault(AppCredential c) => c.Locations.FirstOrDefault()?.Vault;

    protected override Func<AppCredential, (string? Key, string? Label)> SubscriptionSelector =>
        c => (Vault(c)?.SubscriptionId, Vault(c)?.SubscriptionName);

    protected override Func<AppCredential, string?> RegionSelector => c => Vault(c)?.Location;

    protected override string NoSubscriptionLabel => "(geen Key Vault gevonden)";

    protected override bool ExtraFilter(AppCredential c) => LocationFilter switch
    {
        "found" => c.Locations.Count > 0,
        "missing" => c.Locations.Count == 0,
        _ => true,
    };

    protected override bool HasExtraFilters => LocationFilter != "";
    protected override void ClearExtraFilters() => LocationFilter = "";

    private string VaultItemUrl(KeyVaultMatch l) =>
        $"{Portal.ResourceUrl(Session.Account!.TenantId, l.Vault.Id)}/{(l.ItemKind == "Secret" ? "secrets" : "certificates")}";

    protected override Func<AppCredential, Severity> SeveritySelector => c => c.Severity;

    protected override Func<AppCredential, string?> TypeSelector => c => c.StateLabel;

    private string AppPortalUrl(AppCredential c) =>
        $"https://portal.azure.com/#@{Session.Account!.TenantId}/view/Microsoft_AAD_RegisteredApps/ApplicationMenuBlade/~/Credentials/appId/{c.AppId}";

    protected override IComparable? SortValue(AppCredential c, string key) => key switch
    {
        "severity" => (int)c.Severity,
        "app" => c.AppName.ToLowerInvariant(),
        "kind" => c.Kind.ToString(),
        "state" => c.StateLabel,
        "end" => c.End,
        "location" => c.Locations.FirstOrDefault()?.Label.ToLowerInvariant(),
        "owners" => c.Owners.Count == 0 ? null : string.Join(",", c.Owners).ToLowerInvariant(),
        _ => null,
    };

    protected override IEnumerable<string?> SearchFields(AppCredential c) =>
        [c.AppName, c.AppId, c.Description, c.KeyId, c.StateLabel, .. c.Owners,
         .. c.Locations.SelectMany(l => new[] { l.Vault.Name, l.ItemName, l.Vault.SubscriptionName, l.Vault.ResourceGroup })];

    private async Task ExportAsync()
    {
        var csv = Csv.Build(
            ["Severity", "App", "AppId", "AppObjectId", "Owners", "Kind", "Description", "KeyId", "Thumbprint", "Start", "End", "DaysLeft", "Status", "AppHasValidCredential",
             "KeyVault", "KeyVaultItem", "KeyVaultItemKind", "KeyVaultSubscription", "KeyVaultResourceGroup", "KeyVaultLocation", "Match", "MatchReason", "OtherCandidates",
             "Fix", "AzCli", "AzCliCleanup"],
            Filtered.Select(c =>
            {
                var best = c.Locations.FirstOrDefault();
                return new[]
                {
                    c.Severity.Label(), c.AppName, c.AppId, c.AppObjectId, string.Join(", ", c.Owners), c.Kind.ToString(), c.Description, c.KeyId, c.Thumbprint,
                    c.Start?.ToString("yyyy-MM-dd"), c.End?.ToString("yyyy-MM-dd"), c.DaysLeft?.ToString(), c.StateLabel, c.AppHasValidCredential ? "ja" : "nee",
                    best?.Vault.Name, best?.ItemName, best?.ItemKind, best?.Vault.SubscriptionName, best?.Vault.ResourceGroup, best?.Vault.Location,
                    best?.ConfidenceLabel, best?.Reason,
                    string.Join(" | ", c.Locations.Skip(1).Select(l => $"{l.Label} ({l.ConfidenceLabel})")),
                    c.Fix, c.AzCli, c.AzCliCleanup,
                };
            }));
        await DownloadCsvAsync($"app-credentials-{DateTime.Now:yyyyMMdd-HHmm}.csv", csv);
    }
}
